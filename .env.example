# Contoh .env untuk workspace agent. pasang.py menyalin berkas ini ke .env (yang tidak pernah masuk git),
# lalu mengisi tiga secret 9Router dengan nilai acak. Kunci lain kamu isi sendiri kalau dipakai.
# Nilai di .env juga dipakai hook penjaga: nilai secret di sini ditolak kalau ikut tertulis ke vault,
# dan disensor dari arsip transkrip.

# 9Router (router LLM lokal untuk Hermes). Diisi acak oleh pasang.py. Ganti kalau pernah bocor.
NINEROUTER_JWT_SECRET=<diisi-pasang.py>
NINEROUTER_INITIAL_PASSWORD=<diisi-pasang.py>
NINEROUTER_API_KEY_SECRET=<diisi-pasang.py>

# Kunci klien yang kamu buat sendiri di dasbor 9Router (http://localhost:20128), lalu dipakai Hermes.
# Ditaruh di sini supaya nilainya ikut dijaga hook. Hermes membacanya dari .env miliknya sendiri.
NINEROUTER_API_KEY=<isi-kunci-dari-dasbor-9router>
